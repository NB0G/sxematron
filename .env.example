# Скопируйте этот шаблон в .env рядом с compose.yaml.
# Docker Compose прочитает .env автоматически.

# Адрес, на котором Docker публикует порт. Для reverse proxy на том же
# хосте оставьте 127.0.0.1. Встроенной авторизации у приложения нет.
BIND_ADDRESS=127.0.0.1

# Порт на хосте; внутри контейнера остаётся 3000.
PORT=3000

# Лимиты контейнера: число CPU и объём оперативной памяти.
CPU_LIMIT=2
MEMORY_LIMIT=2g
